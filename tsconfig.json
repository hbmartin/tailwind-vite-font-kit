{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Off deliberately: `index.d.ts` is hand-written and is the package's public API,
    // and skipLibCheck would exempt the one file most worth checking.
    "skipLibCheck": false,

    // Strict, minus the two rules that only make sense in a TypeScript source tree:
    // every parameter would need a JSDoc tag, and every `catch (err)` an inline cast.
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src",
    "bin",
    "scripts",
    "types",
    "index.d.ts",
    "start-server.d.ts",
    "virtual-fonts.d.ts",
    "test/types.test.mjs"
  ]
}
