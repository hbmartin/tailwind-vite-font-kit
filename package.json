{
  "name": "tailwind-vite-font-kit",
  "version": "0.2.1",
  "description": "Self-hosted Google fonts with metric-matched fallbacks for TanStack Start + Tailwind v4, as one Vite plugin",
  "keywords": [
    "vite-plugin",
    "tanstack-start",
    "tailwindcss",
    "fonts",
    "cls",
    "web-vitals",
    "size-adjust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbmartin/tailwind-vite-font-kit.git"
  },
  "homepage": "https://github.com/hbmartin/tailwind-vite-font-kit#readme",
  "bugs": {
    "url": "https://github.com/hbmartin/tailwind-vite-font-kit/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    },
    "./start-server": {
      "types": "./start-server.d.ts",
      "default": "./src/start-server.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": {
    "tss-fonts": "./bin/tss-fonts.mjs"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "start-server.d.ts",
    "virtual-fonts.d.ts",
    "README.md"
  ],
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "prepublishOnly": "pnpm run check && pnpm run publint && pnpm run types:lint",
    "publint": "publint --pack pnpm",
    "registry:build": "npx --yes shadcn@4 build registry/registry.json --output registry/r",
    "release:check": "pnpm run prepublishOnly && pnpm run verify:package",
    "size:report": "npm pack --dry-run --json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"harness/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=77 --test-coverage-branches=77 --test-coverage-functions=75 \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types:lint": "attw --pack . --profile esm-only",
    "verify:package": "npm publish --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1",
    "fontkit": "^2",
    "vite": "^7 || ^8",
    "wawoff2": "^2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "fontkit": {
      "optional": true
    },
    "wawoff2": {
      "optional": true
    }
  },
  "dependencies": {
    "@capsizecss/metrics": "^4",
    "es-module-lexer": "^2.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@capsizecss/unpack": "^4.0.1",
    "@types/node": "^22.20.1",
    "fontkit": "^2.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "wawoff2": "^2.0.1"
  }
}
